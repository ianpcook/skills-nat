    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "openai": "^6.16.0",
    "pg": "^8.17.2",
    "pgvector": "^0.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.8.0",
